# Mẫu cấu hình — COPY thành .env và điền giá trị thật (KHÔNG commit .env).

# --- LLM MaaS (Qwen, OpenAI-compatible) — runtime diễn giải ---
# Thiếu các biến này -> agent vẫn chạy bằng fallback rule-based (test local OK).
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=<maas-api-key>
LLM_MODEL=<ten-model-Qwen-tren-portal>
# Model NHANH cho câu hỏi tự do (mặc định Gemma 4 — không "thinking", ~2-5s). Tùy chọn.
FREEFORM_MODEL=google/gemma-4-31b-it

# --- GreenNode IAM (chỉ dùng lúc deploy qua bộ skill AgentBase) ---
GREENNODE_IAM_CLIENT_ID=<client-id>
GREENNODE_IAM_CLIENT_SECRET=<client-secret>
GREENNODE_MAAS_API_KEY=<api-key>

# Port (mặc định 8080 cho AgentBase)
PORT=8080
